{
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-python.sh\"" }]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash|Edit|Write",
          "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"" }]
        }
      ]
    }
  }